{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ToTheSky: Run Streamlit App",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "ToTheSky: Run Pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v"
            ],
            "justMyCode": true
        }
    ]
}
