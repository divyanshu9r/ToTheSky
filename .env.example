# MySQL Database Connection URL
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
MYSQL_URL=mysql+pymysql://root:root@localhost:3306/tothesky_db

# Google Gemini API Key for AI Timetable Optimization
GOOGLE_API_KEY=

# Gemini Model Name (default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Kaggle API Credentials (Optional - realistic simulated data used if not provided)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Fallback Settings: If MySQL is not reachable, use SQLite for presentation/demo mode
ALLOW_SQLITE_FALLBACK=True
